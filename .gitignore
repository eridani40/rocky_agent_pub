# 依赖与构建产物
node_modules/
dist/
release/
*.tsbuildinfo
.DS_Store

# 真实 env（只保留 *.env.example；tests/test.env 源 tracked 会落到工作树，但此规则忽略不入库）
*.env
!*.env.example

# Swift 构建缓存（含本机绝对路径）
app/computer-native/swift/.build/

# build 期生成产物（vite/runtime-config/gen-version）
app/electron/web-dist/
app/electron/runtime-config.json
app/server/app-version.json

# 开发工具配置
.qoder/
.codex/
.agents/
.claude/
.qoderignore
.vscode/
.idea/

# 运行产物
logs/
states/**/verify/**/round-*/
states/**/verify/e2e/
