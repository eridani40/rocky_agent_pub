# prod.env.example — 打包环境配置 schema（发布者填写）
# 参考: specs/tech/app/envs/[P0]environments.md §3.1（共通键）/ §3.4（prod 专有）/ §3.5（示例）
#       specs/tech/app/package/[P0]packaging_toolchain.md §3.5（版本/签名走环境注入）
#
# 用法: cp prod.env.example prod.env，按下方三类填写。
# prod 不跑运行时，仅参与构建（environments.md §2）；但【白名单】键会被 build-dmg.sh
# 抽进 runtime-config.json 打进 app，供 packaged 运行时回填 process.env（后端起不来的修复）。

# ============================================================
# 【进包·运行时白名单】—— 会打进 app 运行时（runtime-config.json）
#   build-dmg.sh 从这些键生成 app/electron/runtime-config.json 打进 asar，
#   packaged app 启动时 main.ts 读入回填 process.env（后端靠此拿到 API_PORT）。
#   零密钥：此处只放非敏感运行时参数，绝不含任何 key。
# ============================================================
APP_NAME=rocky_agent
APP_ENV=prod
LOG_LEVEL=warn
# 打包产物运行时后端 API 端口（server node:http 监听）
API_PORT=3720
# 数据根目录（会话/配置/凭证落此，含用户在 app 内配置的 LLM key）
DATA_DIR=~/.rocky_agent_prod
# 健康检查路径（server 读 process.env.HEALTH_ENDPOINT）
HEALTH_ENDPOINT=/health
# 卡顿监控（runtime-config 白名单已含；取消注释则 packaged 双击启动即自动开，写 .cpuprofile 到 DATA_DIR/profiles/）
#EVENT_LOOP_MONITOR=1
#MAIN_EVENT_LOOP_MONITOR=1

# ============================================================
# 【仅 build 期，不进包】—— 只在打包时使用，不进 app 运行时
# ============================================================
# 渲染层端口占位：打包产物从文件加载渲染层，运行时不监听此端口（schema 完整性保留）
WEB_PORT=8789
# 产物输出目录（dmg/exe 落此）
BUILD_OUT_DIR=./release
# 版本号已废弃：不再由 prod.env 手填。版本号权威源 = 根 package.json version，
# build-dmg.sh 读它作为产物版本（rocky_agent-{version}-arm64.dmg）。

# ============================================================
# 【密钥·绝不进包·留空占位】—— 仅 build 期签名/公证用，不进 runtime-config
#   v0.0.1 允许未签名（PRD §7.2）；留空时 build-dmg.sh 跳过签名，不致命。
# ============================================================
# macOS 公证（notarization）凭证
APPLE_TEAM_ID=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
# Windows exe 代码签名
CSC_LINK=
CSC_KEY_PASSWORD=
