# dev.env.example — 开发环境配置模板
#
# cp 到项目根 dev.env 后填实际值。日常开发用（worktree 创建时自动复制）。

APP_NAME=your_app
APP_ENV=dev

# 数据目录（留空用默认 ~/.{app}_dev）
DATA_DIR=

# 端口（dev 固定端口，不走 port_alloc.sh 版本分配）← CHANGE 改为你项目的端口
API_PORT=3000
WEB_PORT=5173

# 健康检查端点
HEALTH_ENDPOINT=/health

# 启动命令（env.sh 读这些；用 sh -c 执行）
API_START_CMD="your-api-start-command"
WEB_START_CMD="your-web-start-command"
