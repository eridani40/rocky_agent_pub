#!/usr/bin/env bash
# env.sh.example — AT 测试环境启停模板
#
# cp 到项目后改这三处（标记 ← CHANGE）：
#   1. PORT_ALLOC_SH 路径（如 tests/lib/port_alloc.sh）
#   2. test.env 路径（如 tests/test.env）
#   3. test.env 里 API_START_CMD / WEB_START_CMD / HEALTH_ENDPOINT
#
# ⚠️ AT 与 ET 不可并发（共享端口注册表 + DATA_DIR）
#
# 用法:
#   ./env.sh start    — 启动 test 环境（分配端口 + 起 API + WEB + 健康检查 + 注册）
#   ./env.sh stop     — 停止 test 环境（杀进程树 + 清端口 + 清注册表）
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# ── 路径定位 ────────────────────────────────────────────────────────────────
# 向上找 package.json 确定项目根
ROOT_DIR="$SCRIPT_DIR"
while [ "$ROOT_DIR" != "/" ]; do
  [ -f "$ROOT_DIR/package.json" ] && break
  ROOT_DIR="$(dirname "$ROOT_DIR")"
done
cd "$ROOT_DIR"

APP_NAME="${APP_NAME:-app}"
WT="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo "$ROOT_DIR")")"

# port_alloc.sh 路径 ← CHANGE（cp 后改为你项目的实际路径）
PORT_ALLOC_SH="${SCRIPT_DIR}/port_alloc.sh"
[ -f "$PORT_ALLOC_SH" ] || PORT_ALLOC_SH="$ROOT_DIR/tests/lib/port_alloc.sh"
. "$PORT_ALLOC_SH"

# test.env 路径 ← CHANGE
TEST_ENV="${TEST_ENV:-$ROOT_DIR/tests/test.env}"
[ -f "$TEST_ENV" ] || { echo "[env] ERROR: $TEST_ENV missing"; exit 2; }

# ── start ──────────────────────────────────────────────────────────────────
cmd_start() {
  # 1. 加载 test.env
  set -a; . "$TEST_ENV"; set +a

  # 2. 加载全局 secrets（可选）
  SECRETS="${HOME}/.${APP_NAME}/test.secrets.env"
  [ -f "$SECRETS" ] && { set -a; . "$SECRETS"; set +a; } \
    || echo "[env] WARN: no $SECRETS"

  # 3. DATA_DIR per-worktree
  [ -z "${DATA_DIR:-}" ] && DATA_DIR="${_PORT_DATA_DIR}/${WT}"
  export DATA_DIR
  mkdir -p "$DATA_DIR"

  # 4. 分配端口（版本号编码基址 + 容错窗口）
  _API_BASE=$(_port_at_api_base); _WEB_BASE=$(_port_at_web_base)
  API_PORT="$(_port_pick_free "$_API_BASE" $((_API_BASE + _PORT_WINDOW)))" || {
    echo "[env] ERROR: no free API port in $_API_BASE-$((_API_BASE + _PORT_WINDOW))"; exit 2; }
  WEB_PORT="$(_port_pick_free "$_WEB_BASE" $((_WEB_BASE + _PORT_WINDOW)))" || {
    echo "[env] ERROR: no free WEB port in $_WEB_BASE-$((_WEB_BASE + _PORT_WINDOW))"; exit 2; }
  export API_PORT WEB_PORT
  export BASE_URL="http://127.0.0.1:${API_PORT}"

  # 5. 校验启动命令
  [ -n "${API_START_CMD:-}" ] || { echo "[env] ERROR: API_START_CMD unset in test.env"; exit 2; }

  echo "[env] DATA_DIR=$DATA_DIR  worktree=$WT  api=$API_PORT  web=$WEB_PORT"

  # 6. 清 stale pidfile
  PIDFILE="/tmp/${APP_NAME}-${WT}.pid"
  [ -f "$PIDFILE" ] && { kill "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null || true; rm -f "$PIDFILE"; }

  # 7. 启动 API（后台 nohup，继承环境变量）
  MOCK_LLM="${MOCK_LLM:-0}"
  LOG="/tmp/${APP_NAME}-${WT}.log"
  nohup env APP_NAME="$APP_NAME" APP_ENV=test NODE_ENV=test \
    API_PORT="$API_PORT" WEB_PORT="$WEB_PORT" DATA_DIR="$DATA_DIR" \
    BASE_URL="$BASE_URL" MOCK_LLM="$MOCK_LLM" \
    sh -c "$API_START_CMD" > "$LOG" 2>&1 &
  echo $! > "$PIDFILE"

  # 8. 健康检查（15s timeout，500ms 间隔）
  HEALTH_EP="${HEALTH_ENDPOINT:-/health}"
  for i in $(seq 1 30); do
    if curl -sf "${BASE_URL}${HEALTH_EP}" >/dev/null 2>&1; then
      PID="$(cat "$PIDFILE")"
      echo "[env] API ready at $BASE_URL (pid=$PID)"

      # 9. 启动 WEB（如有）
      if [ -n "${WEB_START_CMD:-}" ]; then
        WEB_PIDFILE="/tmp/${APP_NAME}-${WT}-web.pid"
        nohup env WEB_PORT="$WEB_PORT" API_PORT="$API_PORT" \
          sh -c "$WEB_START_CMD" > "/tmp/${APP_NAME}-${WT}-web.log" 2>&1 &
        echo $! > "$WEB_PIDFILE"
        # 等 WEB 就绪（最长 30s）
        for _ in $(seq 1 60); do
          curl -fsS "http://127.0.0.1:${WEB_PORT}/" >/dev/null 2>&1 && break
          sleep 0.5
        done
        curl -fsS "http://127.0.0.1:${WEB_PORT}/" >/dev/null 2>&1 \
          && echo "[env] WEB ready at http://127.0.0.1:${WEB_PORT}" \
          || echo "[env] WARN: WEB not ready (continuing)"
      fi

      # 10. 注册到 port_alloc
      _port_register "$API_PORT" "$WEB_PORT" "$PID" "$MOCK_LLM"
      echo "[env] OK: api=$API_PORT web=$WEB_PORT"
      exit 0
    fi
    sleep 0.5
  done
  echo "[env] ERROR: server not ready in 15s — see $LOG"
  exit 1
}

# ── stop ───────────────────────────────────────────────────────────────────
cmd_stop() {
  PIDFILE="/tmp/${APP_NAME}-${WT}.pid"
  WEB_PIDFILE="/tmp/${APP_NAME}-${WT}-web.pid"

  # 杀 API 进程树
  if [ -f "$PIDFILE" ]; then
    PID="$(cat "$PIDFILE" 2>/dev/null)"
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
      _port_kill_tree "$PID"
      echo "[env] killed API pid=$PID"
    fi
    rm -f "$PIDFILE"
  fi

  # 杀 WEB 进程树
  if [ -f "$WEB_PIDFILE" ]; then
    WPID="$(cat "$WEB_PIDFILE" 2>/dev/null)"
    if [ -n "$WPID" ] && kill -0 "$WPID" 2>/dev/null; then
      _port_kill_tree "$WPID"
      echo "[env] killed WEB pid=$WPID"
    fi
    rm -f "$WEB_PIDFILE"
  fi

  # 清注册表
  _port_free
  echo "[env] OK: stopped worktree=$WT"
}

# ── 入口 ───────────────────────────────────────────────────────────────────
[ $# -ge 1 ] || { echo "Usage: $0 {start|stop}"; exit 1; }
case "$1" in
  start) cmd_start ;;
  stop)  cmd_stop ;;
  *)     echo "Usage: $0 {start|stop}"; exit 1 ;;
esac
