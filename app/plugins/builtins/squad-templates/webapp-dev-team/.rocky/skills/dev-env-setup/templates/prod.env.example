# prod.env.example — 生产环境配置模板
#
# cp 到项目根 prod.env 后填实际值。打包时注入。

APP_NAME=your_app
APP_ENV=prod

# 数据目录（留空用默认）
DATA_DIR=

# 端口（生产固定端口）← CHANGE 改为你项目的端口
API_PORT=3000
WEB_PORT=5173

# 健康检查端点
HEALTH_ENDPOINT=/health

# 启动命令
API_START_CMD="your-api-start-command"
WEB_START_CMD="your-web-start-command"
