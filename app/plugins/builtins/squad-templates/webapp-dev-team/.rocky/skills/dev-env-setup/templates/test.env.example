# test.env.example — 测试环境配置模板
#
# cp 到项目根 tests/test.env 后填实际值。
# env.sh start 会 source 本文件，然后 port_alloc.sh 覆盖 API_PORT/WEB_PORT 为版本分配端口。

APP_NAME=your_app
APP_ENV=test

# 端口（port_alloc.sh 会覆盖为版本分配的端口）
API_PORT=42000
WEB_PORT=44000
DATA_DIR=

# 健康检查端点
HEALTH_ENDPOINT=/health

# 启动命令（env.sh 读这些；用 sh -c 执行，支持管道和多命令）
API_START_CMD="your-api-start-command"
WEB_START_CMD="your-web-start-command"

# 真 LLM 开关（0=真实 LLM，1=mock）
MOCK_LLM=0
