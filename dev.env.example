# dev.env.example — 开发环境配置 schema（开发者本人填写）
# 参考: specs/tech/app/envs/[P0]environments.md §3.1（共通键）/ §3.3（dev 专有）/ §3.5（示例）
#
# 用法: cp dev.env.example dev.env，填入端口；LLM key 在 app 内配置（Settings → Providers，落 DATA_DIR），不进 env。
# .env 全部 gitignore（见 §4.3）。

# ===== 共通键（§3.1）=====
APP_NAME=rocky_agent
APP_ENV=dev
LOG_LEVEL=debug
# 后端 HTTP API 端口（dev 段，AT 不打此端口）
API_PORT=3710
# 渲染层 Vite dev server 端口（dev 段）
WEB_PORT=8788
DATA_DIR=~/.rocky_agent_dev
# 健康检查路径（scripts/run-dev.sh 轮询 server 就绪用）
HEALTH_ENDPOINT=/health

# ===== 启动命令键（scripts.md §3.2 隐含 / environments.md §3.1）=====
# run-dev.sh 通过 `sh -c "$API_START_CMD"` / `sh -c "$WEB_START_CMD"` 起进程，
# 不再硬编码 `bun --filter`（避免 T2/T3 review 留的 Major：filter 与多包名解耦）。
# 用单引号让 $WEB_PORT 以字面进入字符串；run-dev.sh 在 sh -c 上下文展开。
API_START_CMD="bun run app/server/src/index.ts"
WEB_START_CMD='cd app/web && bun run dev -- --port $WEB_PORT --strictPort'

# ===== dev 专有 =====
# 注意：LLM provider key 不走 env —— 在 app 内 Settings → Providers 配置（落 DATA_DIR）。
# 日志级别走 LOG_LEVEL（上方共通键），无独立 DEBUG 开关。

# 事件循环卡顿监控（可选，默认关；lag 超阈值自动抓 .cpuprofile 到 DATA_DIR/profiles/）
#EVENT_LOOP_MONITOR=1        # 后端 server 进程
#MAIN_EVENT_LOOP_MONITOR=1   # Electron 主进程

# web-fetch 出站 HTTP 代理（缺省走系统代理 / 直连）
#HTTP_PROXY=
#HTTPS_PROXY=

# ===== [v0.0.105] computer use dev 截图通道（P0-G，change_plan_v2 §5.5）=====
# 激活后 agent 截图（screenshot tool）在 run-dev.sh dev 模式即可闭环验证：
#   独立 bun 后端 LoopbackComputerNativePort 纯 fetch → Electron 主进程 loopback server
#   → desktopCapturer 全屏截图 → base64 → ImageBlock 回灌 LLM。
# 设了这两键才走 loopback；不设则 dev 截图降级「仅桌面 App 可用」（向后兼容）。
# run-dev.sh `set -a . ./dev.env` 已让两键导出给 Electron 主进程 + bun 后端（同一份 env，天然对齐）。
# 端口任选空闲（避开 API_PORT/WEB_PORT）；token 任意本地字符串（127.0.0.1 bind + token 防同机误撞）。
ROCKY_DEV_COMPUTER_LOOPBACK_PORT=3719
ROCKY_DEV_COMPUTER_LOOPBACK_TOKEN=change-me-dev-token
