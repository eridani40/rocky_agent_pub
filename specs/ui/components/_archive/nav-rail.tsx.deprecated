/**
 * @DEPRECATED v0.0.74 — nav-rail 镜像 tsx 已过时（仅含 nav-chat/plugin/dev，缺 studio/skill/connector）。
 * 权威源 = app/web/src/components/framework/nav-rail/nav-rail.tsx（生产实现）。
 * 本镜像 tsx 不再维护，仅作历史参考。testid 契约见 specs/ui/components/framework/nav-rail.md。
 *
 * nav-rail — ~56px 窄图标栏（brand「R」+ 4 图标 + 底部 theme-toggle）
 * 参考: specs/ui/components/framework/nav-rail.md
 * 生产实现: app/web/src/components/framework/nav-rail/nav-rail.tsx
 *
 * 示意要点：受控（currentView 由父级下发）、tooltip absolute 不占流、
 * 左竖条 border-l-2 预留占位（transparent→accent）切换不位移（v0.0.4 布局稳定性）。
 * [v0.0.12] brand 节点补全（对齐生产 nav-rail.tsx:116-120），文本 E→R（Rocky）。
 */

interface NavItem {
  view: string;
  testid: string;
  label: string; // tooltip + aria-label
  icon: React.ReactNode;
}

interface NavRailProps {
  currentView: string;
  onChange: (view: string) => void;
}

const NAV_ITEMS: NavItem[] = [
  { view: 'chat', testid: 'nav-chat', label: '会话', icon: <ChatIcon /> },
  { view: 'settings-app', testid: 'nav-settings-app', label: '用户设置', icon: <GearIcon /> },
  { view: 'settings-plugin', testid: 'nav-settings-plugin', label: '插件设置', icon: <PuzzleIcon /> },
  { view: 'settings-dev', testid: 'nav-settings-dev', label: '系统设置', icon: <TerminalIcon /> },
];

function NavIcon({ item, active, onClick }: { item: NavItem; active: boolean; onClick: () => void }) {
  return (
    <button
      type="button"
      data-testid={item.testid}
      data-active={active ? 'true' : 'false'}
      aria-current={active ? 'page' : undefined}
      aria-label={item.label}
      onClick={onClick}
      className={
        // 左竖条始终预留 1px 占位（border-l-transparent → border-l-accent），切换不位移
        'group relative flex items-center justify-center w-10 h-10 rounded-sm transition-colors border-l-2 ' +
        (active
          ? 'border-l-accent bg-accent-surface text-accent'
          : 'border-l-transparent text-fg-2 hover:bg-bg-warm hover:text-fg')
      }
    >
      {item.icon}
      {/* hover tooltip：absolute 定位脱离文档流，出现/消失不导致位移 */}
      <span
        role="tooltip"
        className="pointer-events-none absolute left-full ml-2 z-50 whitespace-nowrap rounded-sm bg-code-bg text-code-fg px-2 py-1 text-xs shadow-md opacity-0 group-hover:opacity-100 transition-opacity"
      >
        {item.label}
      </span>
    </button>
  );
}

export function NavRail({ currentView, onChange }: NavRailProps) {
  return (
    <nav data-testid="nav-rail" className="flex flex-col items-center gap-2 p-1 w-14 h-full">
      {/* [v0.0.12] brand「R」：橙色圆角方块 + Playfair 衬线（对齐生产 nav-rail.tsx:116-120） */}
      <div
        data-testid="nav-brand"
        aria-label="Rocky"
        className="mb-5 flex items-center justify-center w-[34px] h-[34px] rounded-lg bg-accent text-white font-serif font-bold text-base shadow-sm"
      >
        R
      </div>
      {NAV_ITEMS.map((item) => (
        <NavIcon
          key={item.testid}
          item={item}
          active={currentView === item.view}
          onClick={() => onChange(item.view)}
        />
      ))}
      {/* spacer：把 theme-toggle 推到底部（生产对齐） */}
      <div className="flex-1" />
      {/* theme-toggle 示意省略，详见生产实现 */}
    </nav>
  );
}

// —— 内联图标（stroke=currentColor，跟随 active/hover 文字色）——
function ChatIcon() {
  return (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden>
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
    </svg>
  );
}
function GearIcon() {
  return (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden>
      <circle cx="12" cy="12" r="3" />
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
    </svg>
  );
}
function PuzzleIcon() {
  return (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden>
      <path d="M5 9V7a2 2 0 0 1 2-2h2a2 2 0 1 1 4 0h2a2 2 0 0 1 2 2v2a2 2 0 1 1 0 4v2a2 2 0 0 1-2 2h-2a2 2 0 1 1-4 0H7a2 2 0 0 1-2-2v-2a2 2 0 1 1 0-4z" />
    </svg>
  );
}
function TerminalIcon() {
  return (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden>
      <polyline points="4 17 10 11 4 5" />
      <line x1="12" y1="19" x2="20" y2="19" />
    </svg>
  );
}

export default NavRail;
